{
  "description": "Get VMs from OpenTofu/Terraform state for inventory",
  "parameters": {
    "provider": {
      "description": "Provider name (maps to tf/providers/<provider>/)",
      "type": "Optional[String]",
      "default": "proxmox"
    },
    "tag_filter": {
      "description": "Filter by tag (e.g., 'puppetinfra', 'puppet', 'scm', 'cd4pe', 'puppetagents')",
      "type": "Optional[String]"
    }
  },
  "input_method": "environment"
}
