{
  "description": "Create Proxmox VM template with KFVEE numbering system",
  "parameters": {
    "template_name": {
      "description": "Name of the OS template (e.g., 'alma', 'ubuntu')",
      "type": "String"
    },
    "template_version": {
      "description": "Version of the OS (e.g., '8', '22.04')",
      "type": "String"
    },
    "iso_url": {
      "description": "URL to download the ISO from",
      "type": "String"
    },
    "iso_filename": {
      "description": "Filename for the ISO",
      "type": "String"
    },
    "vmid": {
      "description": "VM ID to use (will auto-calculate KFVEE if not provided)",
      "type": "Optional[Integer]"
    },
    "storage_location": {
      "description": "Proxmox storage location",
      "type": "Optional[String]"
    },
    "force_rebuild": {
      "description": "Force rebuild even if template exists",
      "type": "Optional[Boolean]"
    }
  },
  "implementations": [
    {
      "name": "create_proxmox_template.rb"
    }
  ]
}
